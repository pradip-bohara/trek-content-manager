<section class="traveller-lead-section">
  
  <!-- LEFT SIDE: Single Dynamic Hero Background Image -->
  <div class="traveller-lead__visual">
    <!-- Active background images that fade smoothly based on selection -->
    <div class="hero-bg-image active" id="bg-backpacker" style="background-image: url('https://images.unsplash.com/photo-1544735716-392fe2489ffa?auto=format&fit=crop&w=1600&q=80');"></div>
    <div class="hero-bg-image" id="bg-explorer" style="background-image: url('https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=1600&q=80');"></div>
    <div class="hero-bg-image" id="bg-luxury" style="background-image: url('https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=1600&q=80');"></div>
    <div class="hero-bg-image" id="bg-soul_searcher" style="background-image: url('https://images.unsplash.com/photo-1519681393784-d120267933ba?auto=format&fit=crop&w=1600&q=80');"></div>
    <div class="hero-bg-image" id="bg-adventurer" style="background-image: url('https://images.unsplash.com/photo-1534447677768-be436bb09401?auto=format&fit=crop&w=1600&q=80');"></div>

    <!-- Black Overlay -->
    <div class="dark-overlay"></div>

    <!-- Floating Email Input Over Left Image -->
    <div class="left-overlay-input desktop-only">
      <input type="email" class="travellerEmailInput" placeholder="Enter your email ...." required />
      <span class="email-error-msg">Please enter a valid email address</span>
    </div>
  </div>

  <!-- RIGHT SIDE: Content & Interactive Form -->
  <div class="traveller-lead__content">
    
    <div class="content-header">
      <h2 class="traveller-title">Tell us, What kind of traveller are you?</h2>
    </div>

    <form id="travellerLeadForm" class="traveller-form" novalidate>
      <input type="hidden" id="travellerType" name="traveller_type" value="backpacker" required />

      <!-- Mobile Email Field -->
      <div class="mobile-email-wrapper mobile-only">
        <input type="email" class="travellerEmailInput" placeholder="Enter your email ...." required />
        <span class="email-error-msg">Please enter a valid email address</span>
      </div>

      <!-- Selection List options -->
      <ul class="traveller-list-options" id="travellerList">
        <li class="option-item active" data-value="backpacker" data-bg="bg-backpacker">
          <span class="option-text">The Backpacker</span>
          <span class="option-num">01</span>
        </li>
        <li class="option-item" data-value="explorer" data-bg="bg-explorer">
          <span class="option-text">The Explorer</span>
          <span class="option-num">02</span>
        </li>
        <li class="option-item" data-value="luxury" data-bg="bg-luxury">
          <span class="option-text">The Luxury Traveller</span>
          <span class="option-num">03</span>
        </li>
        <li class="option-item" data-value="soul_searcher" data-bg="bg-soul_searcher">
          <span class="option-text">The Soul Searcher</span>
          <span class="option-num">04</span>
        </li>
        <li class="option-item" data-value="adventurer" data-bg="bg-adventurer">
          <span class="option-text">The Adventurer</span>
          <span class="option-num">05</span>
        </li>
      </ul>

      <!-- Submit Button -->
      <button type="submit" class="submit-btn" id="submitBtn">
        <span>Get Details</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </button>

      <div id="formResponse" class="form-response"></div>
    </form>
  </div>

</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=Open+Sans:wght@400;500;600&display=swap');

  /* MAIN 100VH SECTION CONTAINER */
  .traveller-lead-section {
    position: relative;
    width: 100%;
    height: 100vh;
    min-height: 650px;
    background: #ffffff;
    font-family: "Open Sans", Arial, sans-serif;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
  }

  /* LEFT SIDE CONTAINER FOR SINGLE IMAGE */
  .traveller-lead__visual {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #111111;
  }

  /* BACKGROUND IMAGE STYLES & CROSSFADE TRANSITION */
  .hero-bg-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    opacity: 0;
    transform: scale(1.05);
    transition: opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1), transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .hero-bg-image.active {
    opacity: 1;
    transform: scale(1);
  }

  /* BLACK OVERLAY FOR BETTER EMAIL FIELD VISIBILITY */
  .dark-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.28);
    z-index: 2;
    pointer-events: none;
  }

  /* FLOATING EMAIL INPUT OVER LEFT IMAGE */
  .left-overlay-input {
    position: absolute;
    z-index: 10;
    width: min(380px, 85%);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .travellerEmailInput {
    width: 100%;
    padding: 16px 22px;
    font-size: 15px;
    font-family: "Open Sans", Arial, sans-serif;
    color: #111111;
    background: #ffffff;
    border: 1.5px solid #111111;
    border-radius: 0px;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.22);
    outline: none;
    box-sizing: border-box;
    transition: all 0.3s ease;
  }

  .travellerEmailInput:focus {
    background: #ffffff;
    border-color: #d1ad54;
    box-shadow: 0 0 0 3px rgba(209, 173, 84, 0.3);
  }

  .email-error-msg {
    display: none;
    font-size: 12px;
    color: #ff5252;
    margin-top: 6px;
    font-weight: 500;
  }

  /* RIGHT SIDE CONTENT */
  .traveller-lead__content {
    padding: 40px clamp(24px, 5vw, 60px);
    max-width: 480px;
    z-index: 5;
  }

  .traveller-title {
    margin: 0 0 32px;
    font-family: "Newsreader", Georgia, serif;
    font-size: clamp(34px, 3.8vw, 50px);
    line-height: 1.15;
    font-weight: 400;
    letter-spacing: -0.02em;
    color: #111111;
  }

  /* FORM & LIST STYLING */
  .traveller-form {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .traveller-list-options {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .option-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 0;
    border-bottom: 1px solid #e1e7e2;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .option-text {
    font-family: "Newsreader", Georgia, serif;
    font-size: 21px;
    color: #777777;
    transition: color 0.3s ease;
  }

  .option-num {
    font-size: 13px;
    color: #aaaaaa;
    font-family: "Open Sans", Arial, sans-serif;
  }

  .option-item:hover .option-text {
    color: #617654;
  }

  .option-item.active {
    border-bottom: 1.5px solid #d1ad54;
  }

  .option-item.active .option-text {
    color: #111111;
    font-weight: 500;
  }

  .option-item.active .option-num {
    color: #111111;
  }

  /* SUBMIT BUTTON */
  .submit-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 16px 28px;
    background-color: #617654;
    color: #ffffff;
    font-size: 15px;
    font-weight: 600;
    border: none;
    border-radius: 2px;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .submit-btn:hover {
    background-color: #4d5e43;
    box-shadow: 0 6px 18px rgba(97, 118, 84, 0.25);
  }

  .form-response {
    font-size: 14px;
    display: none;
  }

  .form-response.success {
    display: block;
    color: #2e7d32;
  }

  .form-response.error {
    display: block;
    color: #c62828;
  }

  .mobile-only { display: none; }
  .desktop-only { display: block; }

  /* MOBILE RESPONSIVE LAYOUT */
  @media (max-width: 992px) {
    .desktop-only { display: none !important; }
    .mobile-only { display: block !important; }

    .traveller-lead-section {
      grid-template-columns: 1fr;
      height: auto;
      min-height: 100vh;
      position: relative;
    }

    .traveller-lead__visual {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
    }

    .dark-overlay {
      background: rgba(255, 255, 255, 0.88); /* Lighter background for readability on mobile */
    }

    .traveller-lead__content {
      position: relative;
      z-index: 5;
      padding: 60px 24px;
      max-width: 100%;
      box-sizing: border-box;
    }

    .traveller-title {
      font-size: 34px;
      margin-bottom: 20px;
    }

    .mobile-email-wrapper {
      margin-bottom: 8px;
    }

    .email-error-msg {
      color: #d32f2f;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    // 1. Interactive Selection & Dynamic Image Swap
    const listItems = document.querySelectorAll("#travellerList .option-item");
    const hiddenInput = document.getElementById("travellerType");
    const bgImages = document.querySelectorAll(".hero-bg-image");

    function changeBackgroundImage(bgId) {
      bgImages.forEach(img => {
        if (img.id === bgId) {
          img.classList.add("active");
        } else {
          img.classList.remove("active");
        }
      });
    }

    listItems.forEach((item) => {
      // Hover event to preview image
      item.addEventListener("mouseenter", function () {
        const bgId = this.getAttribute("data-bg");
        changeBackgroundImage(bgId);
      });

      // Click event to confirm selection
      item.addEventListener("click", function () {
        listItems.forEach((li) => li.classList.remove("active"));
        this.classList.add("active");
        
        const val = this.getAttribute("data-value");
        const bgId = this.getAttribute("data-bg");
        
        hiddenInput.value = val;
        changeBackgroundImage(bgId);
      });
    });

    // Reset to active option image when mouse leaves the list container
    const listContainer = document.getElementById("travellerList");
    listContainer.addEventListener("mouseleave", function () {
      const activeItem = document.querySelector("#travellerList .option-item.active");
      if (activeItem) {
        changeBackgroundImage(activeItem.getAttribute("data-bg"));
      }
    });

    // 2. Email Validation Logic
    function validateEmail(email) {
      const re = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      return re.test(String(email).toLowerCase());
    }

    const emailInputs = document.querySelectorAll(".travellerEmailInput");

    // Sync email inputs across views & validate dynamically
    emailInputs.forEach(input => {
      input.addEventListener("input", function() {
        const val = this.value;
        const parent = this.parentElement;
        const errSpan = parent.querySelector(".email-error-msg");
        
        emailInputs.forEach(otherInput => {
          if(otherInput !== this) otherInput.value = val;
        });

        if (validateEmail(val.trim())) {
          if (errSpan) errSpan.style.display = "none";
          this.style.borderColor = "#617654";
        }
      });
    });

    // 3. Form Submission Handling
    const form = document.getElementById("travellerLeadForm");
    const responseDiv = document.getElementById("formResponse");
    const submitBtn = document.getElementById("submitBtn");

    form.addEventListener("submit", function (e) {
      e.preventDefault();

      let activeEmailInput = Array.from(emailInputs).find(input => input.offsetWidth > 0 && input.offsetHeight > 0);
      if (!activeEmailInput) activeEmailInput = emailInputs[0];

      const emailValue = activeEmailInput.value.trim();
      const parent = activeEmailInput.parentElement;
      const errSpan = parent.querySelector(".email-error-msg");

      // Frontend Email Validation
      if (!validateEmail(emailValue)) {
        if (errSpan) errSpan.style.display = "block";
        activeEmailInput.style.borderColor = "#d32f2f";
        activeEmailInput.focus();
        return;
      } else {
        if (errSpan) errSpan.style.display = "none";
      }

      const travellerType = hiddenInput.value;

      submitBtn.disabled = true;
      submitBtn.innerText = "Sending...";

      const formData = new FormData();
      formData.append("action", "handle_traveller_lead");
      formData.append("traveller_type", travellerType);
      formData.append("email", emailValue);

      const ajaxUrl = typeof wp_ajax_obj !== "undefined" ? wp_ajax_obj.ajax_url : "/wp-admin/admin-ajax.php";

      fetch(ajaxUrl, {
        method: "POST",
        body: formData,
      })
        .then((res) => res.json())
        .then((data) => {
          submitBtn.disabled = false;
          submitBtn.innerHTML = `<span>Get Details</span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>`;

          if (data.success) {
            responseDiv.className = "form-response success";
            responseDiv.innerText = "Thank you! Your trip details have been emailed.";
            form.reset();
            emailInputs.forEach(i => i.value = "");
          } else {
            responseDiv.className = "form-response error";
            responseDiv.innerText = data.data || "Something went wrong. Please try again.";
          }
        })
        .catch(() => {
          submitBtn.disabled = false;
          submitBtn.innerHTML = `<span>Get Details</span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>`;
          responseDiv.className = "form-response error";
          responseDiv.innerText = "Server connection error. Please try again later.";
        });
    });
  });
</script>